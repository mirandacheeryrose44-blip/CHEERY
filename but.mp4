}</style><style type="text/css">.tiktok-cookie-banner.paas_lemon8 {
  box-shadow: 0px -0.5px 0px 0px rgba(0, 0, 0, 0.05);
}

.tiktok-cookie-banner {
  font-family: "tiktok-text-regular", PingFangSC, sans-serif;
  font-weight: 400;
  font-size: 18px;
  line-height: 130%;
  letter-spacing: -0.16%;
  position: fixed;
  left: 0;
  bottom: 0;
  right: 0;
  background: var(--banner-background-color--, #10a2c5);
  z-index: 10001;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  color: #fff;
  padding: 24px 64px 32px;
  box-sizing: border-box;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
  -moz-text-size-adjust: 100%;
       text-size-adjust: 100%;
  -webkit-text-size-adjust: 100%;
  -ms-text-size-adjust: 100%;
  -webkit-font-smoothing: antialiased;
}
.tiktok-cookie-banner .cookie-content .cookie-title {
  font-family: "tiktok-display-bold", PingFangSC, sans-serif;
  font-weight: 700;
  font-size: 24px;
  line-height: 125%;
  letter-spacing: 1%;
  margin-top: 0;
  margin-bottom: 0;
  color: var(--banner-title-color--, #fff);
}
.tiktok-cookie-banner .cookie-content .cookie-desc {
  font-family: "tiktok-text-regular", PingFangSC, sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 130%;
  letter-spacing: 0.19%;
  margin-top: 8px;
  margin-bottom: 0;
  color: var(--banner-desc-color--, #fff);
}
.tiktok-cookie-banner .cookie-content .cookie-desc a {
  font-family: "tiktok-text-medium", PingFangSC, sans-serif;
  font-weight: 600;
  font-size: 16px;
  line-height: 130%;
  letter-spacing: 0.19%;
  text-decoration: none;
  color: var(--banner-link-color--, #fff);
}
.tiktok-cookie-banner .cookie-content .cookie-desc a:hover {
  text-decoration: underline;
  color: var(--banner-link-hover-color--, #fff);
}
.tiktok-cookie-banner .button-wrapper {
  display: flex;
  margin-left: 64px;
}
.tiktok-cookie-banner .button-wrapper a,
.tiktok-cookie-banner .button-wrapper button {
  font-family: "tiktok-text-bold", PingFangSC, sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 130%;
  letter-spacing: 0.19%;
  box-sizing: border-box;
  padding: 0 24px;
  height: 46px;
  min-width: 153px;
  white-space: nowrap;
  border-radius: 4px;
  border: 1px solid rgba(22, 24, 35, 0.12);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  cursor: pointer;
  background: #fff;
  color: #161823;
  outline: none;
  text-decoration: none;
  border: 1px solid rgba(22, 24, 35, 0.12);
}
.tiktok-cookie-banner .button-wrapper a:hover,
.tiktok-cookie-banner .button-wrapper button:hover {
  background: #f8f8f8;
}
.tiktok-cookie-banner .button-wrapper button {
  margin-left: 16px;
  background: var(--banner-button-background-color--, #fff);
  color: var(--banner-button-text-color--, #161823);
}
.tiktok-cookie-banner .button-wrapper button:hover {
  background: var(--banner-button-hover-background-color--, #f8f8f8);
}
@media (min-width: 768px) and (max-width: 1200px) {
  .tiktok-cookie-banner .special-button-wrapper button {
    height: auto;
    min-height: 44px;
    white-space: pre-wrap;
  }
}
.tiktok-cookie-banner.is-rtl {
  direction: rtl;
}
.tiktok-cookie-banner.is-rtl .button-wrapper {
  margin-left: unset;
  margin-right: 64px;
}
.tiktok-cookie-banner.is-rtl .button-wrapper button {
  margin-left: unset;
  margin-right: 16px;
}
@media (max-width: 991px) {
  .tiktok-cookie-banner.is-rtl .button-wrapper button {
    margin-right: 8px;
  }
}
@media (max-width: 991px) {
  .tiktok-cookie-banner {
    flex-direction: column;
    height: auto;
    padding: 16px 16px 20px;
    box-shadow: none;
  }
  .tiktok-cookie-banner .cookie-content .cookie-title {
    font-family: "tiktok-text-bold", PingFangSC, sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 130%;
    letter-spacing: 0.19%;
    text-align: center;
    color: var(--banner-title-color--, #fff);
  }
  .tiktok-cookie-banner .cookie-content .cookie-desc {
    font-family: "tiktok-text-regular", PingFangSC, sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 130%;
    letter-spacing: 1.34%;
    width: auto;
    text-align: center;
    color: var(--banner-desc-color--, #fff);
  }
  .tiktok-cookie-banner .cookie-content .cookie-desc a {
    font-family: "tiktok-text-medium", PingFangSC, sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 130%;
    letter-spacing: 1.34%;
    text-decoration: none;
    color: var(--banner-link-color--, #fff);
  }
  .tiktok-cookie-banner .cookie-content .cookie-desc a:hover {
    text-decoration: underline;
    color: var(--banner-link-hover-color--, #fff);
  }
  .tiktok-cookie-banner .button-wrapper {
    align-self: flex-end;
    margin-top: 16px;
    margin-left: 0;
    margin-right: 0;
    width: 100%;
  }
  .tiktok-cookie-banner .button-wrapper a,
  .tiktok-cookie-banner .button-wrapper button {
    font-family: "tiktok-text-medium", PingFangSC, sans-serif;
    font-weight: 600;
    font-size: 15px;
    line-height: 130%;
    letter-spacing: 0.4%;
    min-width: unset;
    padding: 0 6px;
    width: 100%;
    height: 44px;
    border-radius: 2px;
    white-space: pre-wrap;
    margin: 0;
  }
  .tiktok-cookie-banner .button-wrapper button {
    margin-left: 8px;
    height: auto;
    min-height: 44px;
  }
}</style><style type="text/css">:root body.disable-scroll {
  overflow: hidden;
}

.tiktok-cookie-setting-portal {
  font-family: "tiktok-text-regular", PingFangSC, sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 130%;
  letter-spacing: 0.67%;
  position: fixed;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  color: rgb(22, 24, 35);
  -webkit-font-smoothing: antialiased;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-backdrop {
  background-color: rgba(0, 0, 0, 0.5);
  transition: opacity 300ms linear;
  opacity: 0;
  position: fixed;
  inset: 0;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-backdrop.visible {
  opacity: 1;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-container {
  position: fixed;
  inset: 0;
  left: 0;
  top: 32px;
  bottom: 32px;
  left: 16px;
  right: 16px;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 300ms cubic-bezier(0.65, 0, 0.35, 1), transform 300ms cubic-bezier(0.65, 0, 0.35, 1);
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-container.visible {
  opacity: 1;
  transform: scale(1);
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-container .tiktok-cookie-setting-modal {
  position: relative;
  max-width: 700px;
  max-height: 100%;
  background-color: var(--setting-modal-background-color--, #fff);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: rgba(0, 0, 0, 0.12) 0 2px 12px;
  outline: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
@media (max-width: 700px) {
  .tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-container .tiktok-cookie-setting-modal {
    width: calc(100vw - 32px);
  }
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-header-container {
  font-family: "tiktok-display-bold", PingFangSC, sans-serif;
  font-weight: 700;
  font-size: 24px;
  line-height: 125%;
  letter-spacing: 1%;
  padding: 24px 29px 16px 24px;
  color: var(--setting-modal-title-color--, #161823);
  border-bottom: 0.5px solid rgba(22, 24, 35, 0.2);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 0;
}
@media (max-width: 468px) {
  .tiktok-cookie-setting-portal .tiktok-cookie-setting-header-container {
    border-bottom: none;
    padding: 32px 24px 24px;
    font-family: "tiktok-display-bold", PingFangSC, sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 125%;
    letter-spacing: 1.5%;
    justify-content: center;
  }
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-close {
  width: 24px;
  height: 24px;
  cursor: pointer;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-close svg {
  fill: var(--setting-modal-close-icon-color--, rgba(22, 24, 35, 0.6));
}
@media (max-width: 468px) {
  .tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    transform: scale(0.8);
  }
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-description-container {
  background-color: rgba(22, 24, 35, 0.03);
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-modal-description-container .tiktok-cookie-setting-modal-description {
  font-family: "tiktok-text-regular", PingFangSC, sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 130%;
  letter-spacing: 0.19%;
  margin: 20px 24px;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content {
  padding: 12px 40px 12px 24px;
  overflow-y: auto;
  flex: 1 1 auto;
}
@media (max-width: 700px) {
  .tiktok-cookie-setting-portal .tiktok-cookie-setting-content {
    width: calc(100% - 48px);
  }
}
@media (max-width: 468px) {
  .tiktok-cookie-setting-portal .tiktok-cookie-setting-content {
    padding: 6px 16px 0 16px;
  }
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content::-webkit-scrollbar {
  width: 6px;
  margin-right: 8px;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content:hover::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.15);
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content::-webkit-scrollbar-track {
  background: transparent;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content::-webkit-scrollbar-thumb {
  border-radius: 3px;
  background: rgba(0, 0, 0, 0.15);
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content .tiktok-cookie-setting-info-icon {
  margin-left: auto;
  justify-content: flex-end;
  height: 48px;
  cursor: pointer;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content .tiktok-cookie-setting-info-icon.hide {
  transform: rotate(180deg);
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content .tiktok-cookie-setting-info-icon svg {
  width: 14px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 17px;
  fill: var(--setting-modal-arrow-icon-color--, #161823);
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content .tiktok-cookie-vertical-info-icon {
  margin-left: auto;
  margin-right: 20px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content .tiktok-cookie-vendor-group-name {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-family: "tiktok-text-medium", PingFangSC, sans-serif;
  font-weight: 600;
  font-size: 16px;
  line-height: 130%;
  letter-spacing: 0.19%;
  margin-top: 0;
  margin-bottom: 0;
  color: var(--setting-modal-text-color--, #161823);
  flex: 1 1 0;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-content .tiktok-cookie-vendor-group-name .tiktok-cookie-vendor-group-name-outside {
  display: flex;
  align-items: center;
  flex-shrink: 1;
  flex-grow: 1;
}
@media (max-width: 468px) {
  .tiktok-cookie-setting-portal .tiktok-cookie-setting-content .tiktok-cookie-vendor-group-name {
    font-family: "tiktok-text-medium", PingFangSC, sans-serif;
    font-weight: 600;
    font-size: 15px;
    line-height: 130%;
    letter-spacing: 0.4%;
  }
}
.tiktok-cookie-setting-portal cookie-setting-switch {
  line-height: 0;
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-footer {
  padding: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 0.5px solid rgba(22, 24, 35, 0.2);
  flex: 0 0 auto;
}
@media (max-width: 468px) {
  .tiktok-cookie-setting-portal .tiktok-cookie-setting-footer {
    border-top: none;
    padding: 20px;
    flex-direction: column-reverse;
    justify-content: center;
    align-items: stretch;
  }
}
.tiktok-cookie-setting-portal .tiktok-cookie-setting-footer .tiktok-cookie-setting-footer-btn-text,
.tiktok-cookie-setting-portal .tiktok-cookie-setting-footer .tiktok-cookie-setting-footer-btn-primary {
  font-family: "tiktok-text-medium", PingFangSC, sans-serif;
  font-weight: 600;
  font-size: 16px;
