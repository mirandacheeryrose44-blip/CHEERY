}</style><style type="text/css">:root body.global_module_disableScroll__472ccca3 {
  overflow: hidden;
}</style><style type="text/css">.tiktok-cookie-setting-switch {
  box-sizing: border-box;
  display: inline-block;
  border-radius: 12px;
  border: 1px rgba(0, 0, 0, 0) solid;
  position: relative;
  cursor: pointer;
  background-color: var(--setting-modal-switch-toggle-color--, rgba(46, 50, 56, 0.05));
  transition: background-color 200ms ease-in-out;
  width: 40px;
  height: 24px;
}
.tiktok-cookie-setting-switch.checked {
  background-color: var(--setting-modal-switch-toggle-checked-color--, #0be09b);
}
.tiktok-cookie-setting-switch.checked .tiktok-cookie-setting-switch-knob {
  transform: translateX(18px);
}
.tiktok-cookie-setting-switch.disabled {
  opacity: 0.34;
  cursor: not-allowed;
}

.tiktok-cookie-setting-switch-knob {
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(0, 0, 0, 0.08);
  cursor: pointer;
  border-radius: 9px;
  background-color: #fff;
  box-sizing: border-box;
  position: absolute;
  left: 0;
  right: auto;
  transition: transform 200ms ease-in-out, width 200ms ease-in-out;
  width: 18px;
  height: 18px;
  top: 2px;
  transform: translateX(2px);
}

.tiktok-cookie-setting-switch-native-control {
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: inherit;
  pointer-events: auto;
  margin: 0;
  position: absolute;
  top: 0;
  left: 0;
}</style><style data-tiktok-cookie-banner-font="tiktok-display-bold">
